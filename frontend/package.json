{
  "name": "neuroocr-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Client-side handwriting-recognition frontend for NeuroOCR — React + TypeScript + Vite, inference via TensorFlow.js.",
  "author": "bharat3645",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bharat3645/NeuroOCR.git",
    "directory": "frontend"
  },
  "homepage": "https://github.com/bharat3645/NeuroOCR#readme",
  "bugs": {
    "url": "https://github.com/bharat3645/NeuroOCR/issues"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b --noEmit",
    "verify-model": "node scripts/verify-model.mjs",
